  "font": {
    "pixel": "\"Jersey 15\", ui-monospace, monospace",
    "system": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "display": {
      "keep": "var(--font-pixel)",
      "clean": "var(--font-system)"
    },
    "ui": "var(--font-system)"
  },
  "type": {
    "display-xl": {
      "fontSize": "32px",
      "lineHeight": "36px",
      "fontWeight": 700,
      "family": "display",
      "note": "Keep multiplies fontSize and lineHeight by display-by-theme.keep.scale (1.15) and uses weight 400; Clean uses them as listed."
    },
    "display-l": {
      "fontSize": "26px",
      "lineHeight": "30px",
      "fontWeight": 700,
      "family": "display",
      "note": "Keep multiplies fontSize and lineHeight by display-by-theme.keep.scale (1.15) and uses weight 400; Clean uses them as listed."
    },
    "display-m": {
      "fontSize": "20px",
      "lineHeight": "24px",
      "fontWeight": 700,
      "family": "display",
      "note": "Keep multiplies fontSize and lineHeight by display-by-theme.keep.scale (1.15) and uses weight 400; Clean uses them as listed."
    },
    "label": {
      "fontSize": "14px",
      "lineHeight": "18px",
      "fontWeight": 500,
      "family": "display",
      "note": "Keep multiplies fontSize and lineHeight by display-by-theme.keep.scale (1.15) and uses weight 400; Clean uses them as listed."
    },
    "body": {
      "fontSize": "16px",
      "lineHeight": "24px",
      "fontWeight": 400,
      "family": "ui"
    },
    "body-s": {
      "fontSize": "14px",
      "lineHeight": "20px",
      "fontWeight": 400,
      "family": "ui"
    },
    "caption": {
      "fontSize": "12px",
      "lineHeight": "16px",
      "fontWeight": 500,
      "family": "ui"
    },
    "num-input": {
      "fontSize": "24px",
      "lineHeight": "28px",
      "fontWeight": 800,
      "family": "ui",
      "fontVariantNumeric": "tabular-nums"
    },
    "num-stat": {
      "fontSize": "20px",
      "lineHeight": "24px",
      "fontWeight": 700,
      "family": "ui",
      "fontVariantNumeric": "tabular-nums"
    }
  },
  "spacing": {
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "20px",
    "space-6": "24px",
    "space-8": "32px"
  },
  "radius": {
    "radius-none": "0px",
    "radius-control": "12px",
    "radius-card": "16px",
    "radius-sheet": "20px",
    "radius-round": "9999px"
  },
  "size": {
    "tap-min": "44px",
    "tap-log": "56px",
    "tap-primary": "64px",
    "bar-tab": "72px",
    "phone-base": "390px",
    "phone-min": "360px"
  },
  "borderWidth": {
    "border-thin": "2px",
    "border-thick": "3px"
  },
  "opacity": {
    "opacity-upcoming": "0.55",
    "opacity-locked": "0.45"
  },
  "radius-by-theme": {
    "keep": {
      "r-control": "0px",
      "r-card": "0px",
      "r-sheet": "0px"
    },
    "clean": {
      "r-control": "12px",
      "r-card": "16px",
      "r-sheet": "20px"
    }
  },
  "display-by-theme": {
    "keep": {
      "family": "var(--font-pixel)",
      "weightDisplay": 400,
      "weightLabel": 400,
      "scale": 1.15
    },
    "clean": {
      "family": "var(--font-system)",
      "weightDisplay": 700,
      "weightLabel": 600,
      "scale": 1
    }
  }
}