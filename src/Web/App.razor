<Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="new[] { typeof(Ui.IBuildInfo).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <p>Page not found.</p>
    </NotFound>
</Router>
