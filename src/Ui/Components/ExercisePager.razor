@* The Exercise pager (design 8.4): one numbered chip per planned Exercise, a tick once all its Sets are confirmed. Tapping a chip jumps there. *@
<nav class="pager" aria-label="Exercises">
    @for (var i = 0; i < Chips.Count; i++)
    {
        var index = i;
        var chip = Chips[i];
        <button type="button" class="pager__chip"
                aria-current="@(index == Current ? "step" : null)"
                aria-label="@($"Exercise {index + 1}: {chip.Name}{(chip.Done ? ", done" : "")}")"
                @onclick="() => OnJump.InvokeAsync(index)">
            <span class="@(chip.Done ? "pager__done" : null)">@(index + 1)</span>
            @if (chip.Done)
            {
                <span class="pager__done" aria-hidden="true">✓</span>
            }
        </button>
    }
</nav>

@code {
    /// <summary>One chip: the Exercise's name (for the accessible name) and whether all its Sets are confirmed.</summary>
    public sealed record Chip(string Name, bool Done);

    [Parameter, EditorRequired]
    public IReadOnlyList<Chip> Chips { get; set; } = [];

    /// <summary>The zero-based index of the Exercise showing.</summary>
    [Parameter]
    public int Current { get; set; }

    [Parameter]
    public EventCallback<int> OnJump { get; set; }
}
