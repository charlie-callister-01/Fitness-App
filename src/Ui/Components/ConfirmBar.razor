@* C-06 ConfirmBar: fixed to the bottom of the log with the Up next strip, the one primary action and, when the Exercise has them, a stepper either side. *@
<div class="fa-confirmbar">
    @if (UpNext is not null || LastDone || Rest is not null)
    {
        <div class="fa-confirmbar__info">
            @if (UpNext is not null)
            {
                <span>Up next: <b>@UpNext</b></span>
            }
            else if (LastDone)
            {
                <span>Last Exercise done</span>
            }
            @if (Rest is not null)
            {
                <span class="fa-confirmbar__rest" role="timer" aria-live="off">@Rest</span>
            }
        </div>
    }
    <div class="@RowClass">
        @if (ShowSteppers)
        {
            <Button Variant="ButtonVariant.Stepper" AccessibleName="@($"Decrease by {StepName}")" OnClick="() => OnStep.InvokeAsync(-1)">−@StepAmount</Button>
        }
        <Button Variant="ButtonVariant.Primary" Disabled="Disabled" OnClick="HandlePrimary">@PrimaryLabel</Button>
        @if (ShowSteppers)
        {
            <Button Variant="ButtonVariant.Stepper" AccessibleName="@($"Increase by {StepName}")" OnClick="() => OnStep.InvokeAsync(1)">+@StepAmount</Button>
        }
    </div>
</div>

@code {
    /// <summary>"Confirm Set", "Next: Lunge" or "Finish".</summary>
    [Parameter, EditorRequired]
    public string PrimaryLabel { get; set; } = "";

    /// <summary>The name of the Exercise after the one showing, for the "Up next" strip; null when there is none.</summary>
    [Parameter]
    public string? UpNext { get; set; }

    /// <summary>Every Exercise is complete, so the strip says so in place of an Up next.</summary>
    [Parameter]
    public bool LastDone { get; set; }

    /// <summary>The rest countdown, such as "Rest 1:12", shown at the right of the strip; null shows nothing.</summary>
    [Parameter]
    public string? Rest { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnPrimary { get; set; }

    /// <summary>The step shown on the stepper buttons, such as "2" or "4.5"; null hides the steppers.</summary>
    [Parameter]
    public string? StepAmount { get; set; }

    /// <summary>The unit word spoken in the stepper names: "kg", "lb", "s" or "rep".</summary>
    [Parameter]
    public string StepUnit { get; set; } = "";

    /// <summary>A stepper was pressed: -1 for minus, 1 for plus.</summary>
    [Parameter]
    public EventCallback<int> OnStep { get; set; }

    private bool ShowSteppers => StepAmount is not null;

    private string StepName => $"{StepAmount} {StepUnit}";

    private string RowClass => ShowSteppers ? "fa-confirmbar__row" : "fa-confirmbar__row confirm-row--single";

    private Task HandlePrimary() => OnPrimary.InvokeAsync();
}
