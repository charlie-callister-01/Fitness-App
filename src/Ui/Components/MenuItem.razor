@* One row of a menu sheet: an icon, a label and a one-line hint. A row whose feature is not built yet is shown disabled. At least --tap-min tall. *@
<button type="button" class="fa-menuitem" disabled="@Disabled" @onclick="HandleClick">
    <span class="fa-menuitem__icon"><Icon Name="Glyph" /></span>
    <span class="fa-menuitem__text">
        <span class="fa-menuitem__label">@Label</span>
        <span class="fa-menuitem__hint fa-muted">@Hint</span>
    </span>
</button>

@code {
    [Parameter, EditorRequired]
    public IconName Glyph { get; set; }

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    private Task HandleClick() => Disabled ? Task.CompletedTask : OnClick.InvokeAsync();
}
