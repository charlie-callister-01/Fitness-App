@using Core.Rules.Library
@* C-14 ExercisePicker: a sheet to pick one Exercise from the library, shared by Swap, Add an Exercise, the Custom workout draft and (later) the
   Plan editor. What it offers, in what order, and when it has a search box is the Core rule (ExercisePickerRules.Choose) applied to the
   PickerRequest its owner passes. An optional confirm step (used when swapping would remove Sets). "Add a new Exercise" opens the New
   Exercise form; the Exercise it makes counts as picked. It knows nothing about Workouts: the owner hears which Exercise was picked. *@
@{
    var result = Result;
}
<Sheet Open="Open && !_adding" Title="@Title" Opener="Opener" OnClose="OnClose">
    <ChildContent>
        @if (_chosen is not null && ConfirmMessage is not null)
        {
            <p>@ConfirmMessage</p>
        }
        else
        {
            @if (result.ShowSearch)
            {
                <input type="search" class="fa-picker__search" aria-label="Search Exercises" placeholder="Search Exercises"
                       value="@_search" @oninput="OnSearch" />
            }
            @if (result.IsEmpty)
            {
                <p class="fa-picker__empty fa-muted">@(result.NewExerciseOffer is not null ? "No match." : "No other Exercises in your library.")</p>
            }
            else
            {
                @foreach (var group in result.Groups)
                {
                    <ExercisePickerGroup Heading="@group.Heading" Items="group.Items" OnPick="Pick" />
                }
            }
            <div class="fa-picker__new">
                <Button Variant="ButtonVariant.Secondary" OnClick="() => StartAdding(result.NewExerciseOffer)">@AddLabel(result.NewExerciseOffer)</Button>
            </div>
        }
    </ChildContent>
    <Actions>
        @if (_chosen is not null && ConfirmMessage is not null)
        {
            <Button Variant="ButtonVariant.Primary" OnClick="Confirm">@ConfirmLabel</Button>
        }
        <Button Variant="ButtonVariant.Secondary" OnClick="OnClose">Cancel</Button>
    </Actions>
</Sheet>

<NewExerciseSheet Open="Open && _adding" InitialName="@_offer" OfferGuide="false" OnAdded="Added" OnClose="StopAdding" />

@code {
    private string _search = "";
    private string? _chosen;
    private bool _adding;
    private string? _offer;

    [Parameter]
    public bool Open { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>What the picker is for (Swap, Add, Custom workout, Plan editor) and what it must leave out.</summary>
    [Parameter, EditorRequired]
    public PickerRequest Request { get; set; } = default!;

    [Parameter]
    public ElementReference? Opener { get; set; }

    /// <summary>When set, picking an Exercise first shows this message and waits for <see cref="ConfirmLabel"/>.</summary>
    [Parameter]
    public string? ConfirmMessage { get; set; }

    [Parameter]
    public string ConfirmLabel { get; set; } = "Continue";

    /// <summary>The owner chose an Exercise (after the confirm step, when there is one). Passes its ID.</summary>
    [Parameter]
    public EventCallback<string> OnPick { get; set; }

    /// <summary>Asks the owner of the sheet to close it, with nothing changed.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private PickerResult Result => ExercisePickerRules.Choose(Request, _search);

    protected override void OnParametersSet()
    {
        if (!Open)
        {
            _search = "";
            _chosen = null;
            _adding = false;
            _offer = null;
        }
    }

    private static string AddLabel(string? offer) => offer is null ? "Add a new Exercise" : $"Add '{offer}' as a new Exercise";

    private void OnSearch(ChangeEventArgs e) => _search = e.Value?.ToString() ?? "";

    private void StartAdding(string? offer)
    {
        _offer = offer;
        _adding = true;
    }

    private void StopAdding() => _adding = false;

    private Task Added(Core.Model.Exercise exercise)
    {
        _adding = false;
        return Pick(exercise.Id);
    }

    private Task Pick(string id)
    {
        if (ConfirmMessage is null)
        {
            return OnPick.InvokeAsync(id);
        }

        _chosen = id;
        return Task.CompletedTask;
    }

    private Task Confirm() => _chosen is { } id ? OnPick.InvokeAsync(id) : Task.CompletedTask;
}
