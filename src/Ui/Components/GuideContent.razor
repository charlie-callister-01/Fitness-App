@using Core.Model
@* The one read view of a Guide, shared by the log's Guide sheet and the Guide page: its sections in the Guide's own order, the video, then (when
   asked) My notes; or a plain message when the Exercise has none. With OnWatchDemo the video is a button the owner's page answers (so it can
   say when the link cannot open); without it the video is a plain link that opens in a new tab. *@
@if (Guide is null || !HasContent(Guide))
{
    <p class="fa-muted">No Guide yet for @ExerciseName.</p>
}
else
{
    <div class="fa-guide">
        <GuideSection Heading="What it works" Text="@Guide.Works" />
        <GuideSection Heading="Why it's in your plan" Text="@Guide.WhyInPlan" />
        <GuideSection Heading="Setup" Text="@Guide.Setup" />
        <GuideSection Heading="How to do it" Text="@Guide.HowTo" />
        <GuideSection Heading="Cues" Items="Guide.Cues" />
        <GuideSection Heading="Common mistakes" Items="Guide.CommonMistakes" />
        <GuideSection Heading="Easier" Text="@Guide.Easier" />
        <GuideSection Heading="Harder" Text="@Guide.Harder" />
        <GuideSection Heading="Watch-outs" Items="Guide.WatchOuts" />
        @if (VideoLink(Guide) is { } video)
        {
            @if (OnWatchDemo.HasDelegate)
            {
                <Button Variant="ButtonVariant.Secondary" OnClick="() => OnWatchDemo.InvokeAsync(video)">Watch a demo</Button>
            }
            else
            {
                <a class="fa-guide__video" href="@video" target="_blank" rel="noopener">Watch a demo (opens in a new tab)</a>
            }
        }
        @ChildContent
        @if (IncludeNotes)
        {
            <GuideSection Heading="My notes" Text="@Guide.PersonalNotes" />
        }
    </div>
}

@code {
    [Parameter]
    public Guide? Guide { get; set; }

    [Parameter, EditorRequired]
    public string ExerciseName { get; set; } = "";

    /// <summary>Whether My notes is part of this read view (the Guide page shows it itself, with Edit notes).</summary>
    [Parameter]
    public bool IncludeNotes { get; set; } = true;

    /// <summary>The owner tapped Watch a demo; the argument is the web address. When set, the video is a button instead of a link.</summary>
    [Parameter]
    public EventCallback<string> OnWatchDemo { get; set; }

    /// <summary>Shown after the video and before My notes (the Guide page's offline message).</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Whether the Guide has anything to show: a section, the video or personal notes.</summary>
    public static bool HasContent(Guide? g) =>
        g is not null
        && (VideoLink(g) is not null
            || new[] { g.Works, g.WhyInPlan, g.Setup, g.HowTo, g.Easier, g.Harder, g.PersonalNotes }.Any(t => !string.IsNullOrWhiteSpace(t))
            || g.Cues.Count + g.CommonMistakes.Count + g.WatchOuts.Count > 0);

    /// <summary>The video address when it is a web address; anything else (a script address, say) is never made a link.</summary>
    private static string? VideoLink(Guide g) =>
        Uri.TryCreate(g.VideoUrl, UriKind.Absolute, out var uri) && uri.Scheme is "http" or "https" ? uri.AbsoluteUri : null;
}
