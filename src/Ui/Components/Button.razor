@* C-01 Button. Skin comes from the global fa-btn classes; one set of classes for both Themes. *@
@if (Href is not null && !Disabled)
{
    <a class="@CssClass" href="@Href" aria-label="@AccessibleName">@Content</a>
}
else
{
    <button type="button" class="@CssClass" disabled="@Disabled" aria-label="@AccessibleName" @onclick="HandleClick">@Content</button>
}

@code {
    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Secondary;

    /// <summary>Renders a link instead of a button.</summary>
    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnClick { get; set; }

    /// <summary>The icon shown in the Icon variant.</summary>
    [Parameter]
    public IconName? Glyph { get; set; }

    /// <summary>Required for the Icon variant; optional elsewhere when the label needs spelling out.</summary>
    [Parameter]
    public string? AccessibleName { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private Task HandleClick(Microsoft.AspNetCore.Components.Web.MouseEventArgs e) => Disabled ? Task.CompletedTask : OnClick.InvokeAsync(e);

    private string CssClass => $"fa-btn fa-btn--{Variant.ToString().ToLowerInvariant()}";

    protected override void OnParametersSet()
    {
        if (Variant == ButtonVariant.Icon && string.IsNullOrWhiteSpace(AccessibleName))
        {
            throw new InvalidOperationException("An Icon button needs an AccessibleName (design C-01: always aria-label).");
        }
    }

    private RenderFragment Content => @<text>@if (Glyph is { } glyph) { <Icon Name="glyph" /> }@ChildContent</text>;
}
