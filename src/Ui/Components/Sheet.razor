@* The shared Sheet shell (design 8.4, C-13, C-14): a bottom sheet over a backdrop, built once for every sheet and menu. It is a labelled modal
   dialog. Escape and a tap on the backdrop ask the owner of the sheet to close it (OnClose); the owner decides, so a sheet can refuse to
   close. The focus work (start inside, keep Tab inside, return to the opener) is done by Sheet.razor.js. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (Open)
{
    <div class="fa-sheet__backdrop" @onclick="CloseAsync"></div>
    <div class="fa-sheet" role="dialog" aria-modal="true" aria-labelledby="@_titleId" tabindex="-1" @ref="_dialog" @onkeydown="OnKeyDownAsync">
        <h2 id="@_titleId" class="fa-title fa-title--m fa-sheet__title">@Title</h2>
        <div class="fa-sheet__body">@ChildContent</div>
        @if (Actions is not null)
        {
            <div class="fa-sheet__actions">@Actions</div>
        }
    </div>
}

@code {
    private const string ModulePath = "./_content/Ui/Components/Sheet.razor.js";

    private static int _lastId;

    private readonly string _titleId = $"sheet-title-{Interlocked.Increment(ref _lastId)}";
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private int? _attached;
    private bool _syncing;

    [Parameter]
    public bool Open { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>Raised by Escape and by a tap outside the sheet. The owner sets <see cref="Open"/> to false to close.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The buttons along the bottom of the sheet.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>The control that opened the sheet, which gets focus back on close. Falls back to whatever had focus when the sheet opened.</summary>
    [Parameter]
    public ElementReference? Opener { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A render that lands while a JS call is awaited must not attach a second time (that leaks a Tab trap); the running pass
        // keeps going until the attached state matches Open.
        if (_syncing)
        {
            return;
        }

        _syncing = true;
        try
        {
            while (true)
            {
                if (Open && _attached is null)
                {
                    _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
                    _attached = await _module.InvokeAsync<int>("attach", _dialog, Opener);
                }
                else if (!Open && _attached is { } handle && _module is not null)
                {
                    _attached = null;
                    await _module.InvokeVoidAsync("detach", handle);
                }
                else
                {
                    break;
                }
            }
        }
        finally
        {
            _syncing = false;
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private Task OnKeyDownAsync(KeyboardEventArgs e) => e.Key == "Escape" ? CloseAsync() : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        if (_attached is { } handle && _module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("detach", handle);
            }
            catch (JSDisconnectedException)
            {
                // The circuit or page is already gone: nothing to hand focus back to.
            }
        }

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
