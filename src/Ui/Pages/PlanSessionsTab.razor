@using Core.Model
@using Core.Rules.Library
@using Core.Rules.PlanEditing
@* The Plan editor's Sessions tab (design S-05, C-20, F-04): a section per Session on the selected Track with its Exercise rows. A row shows
   a decorative drag handle, the name and "3 x 8"; Edit expands it in place (Sets, Reps, highest Reps, Cue, and on the main Track, Benchmark)
   and Move up, Move down and Remove are text buttons, so reordering never needs a pointer. A Session's name, default day (on weekly Tracks)
   and type change in a sheet, which is also how a new Session is added. A row with bad numbers is named under its Session and holds Save back. *@
<div class="fa-sessions" @key="State.SelectedTrackId">
    @if (SelectedSessions.Count == 0)
    {
        <p class="fa-muted">No Sessions yet. Add one, then add Exercises from your library.</p>
    }

    @foreach (var session in SelectedSessions)
    {
        var sessionId = session.Id;
        <section class="fa-session fa-panel" aria-label="@session.Name">
            <div class="fa-session__head">
                <div>
                    <h2 class="fa-title fa-title--m fa-session__name">@session.Name</h2>
                    <p class="fa-muted fa-session__meta">@DayLabel(session.DefaultDay) · @session.Type</p>
                </div>
                <Button Variant="ButtonVariant.Secondary" Disabled="Disabled" AccessibleName="@($"Edit Session {session.Name}")" OnClick="() => OpenSessionSheet(sessionId)">Edit Session</Button>
            </div>

            @if (session.Exercises.Count == 0)
            {
                <p class="fa-muted">No Exercises in this Session yet.</p>
            }

            <ul class="fa-session__rows">
                @for (var i = 0; i < session.Exercises.Count; i++)
                {
                    var index = i;
                    var row = session.Exercises[i];
                    var exercise = Lookup(row.ExerciseId);
                    var name = exercise.Name;
                    var key = sessionId + "|" + row.ExerciseId;
                    var open = _expandedKey == key;
                    var problem = State.RowProblem(sessionId, row);
                    <li class="fa-row">
                        <div class="fa-row__summary">
                            <span class="fa-row__handle" aria-hidden="true">&#8942;&#8942;</span>
                            <div class="fa-row__text">
                                <p class="fa-row__name">@name</p>
                                <p class="fa-muted fa-row__sets">@SessionRowRules.Summary(row)</p>
                            </div>
                            <Button Variant="ButtonVariant.Secondary" AccessibleName="@(open ? $"Close {name}" : $"Edit {name}")" OnClick="() => Toggle(key)">@(open ? "Done" : "Edit")</Button>
                        </div>

                        @if (open)
                        {
                            <div class="fa-row__edit">
                                <div class="fa-row__triple">
                                    <label class="fa-row__field">
                                        <span class="fa-label">Sets</span>
                                        <input class="fa-row__control" type="text" inputmode="numeric" disabled="@Disabled" value="@NumberText(sessionId, row, RowNumber.Sets)" @onchange="e => SetNumber(sessionId, row.ExerciseId, index, RowNumber.Sets, e)" />
                                    </label>
                                    <label class="fa-row__field">
                                        <span class="fa-label">Reps</span>
                                        <input class="fa-row__control" type="text" inputmode="numeric" disabled="@Disabled" value="@NumberText(sessionId, row, RowNumber.Reps)" @onchange="e => SetNumber(sessionId, row.ExerciseId, index, RowNumber.Reps, e)" />
                                    </label>
                                    <label class="fa-row__field">
                                        <span class="fa-label">Highest Reps</span>
                                        <input class="fa-row__control" type="text" inputmode="numeric" disabled="@Disabled" value="@NumberText(sessionId, row, RowNumber.HighestReps)" @onchange="e => SetNumber(sessionId, row.ExerciseId, index, RowNumber.HighestReps, e)" />
                                    </label>
                                </div>
                                <label class="fa-row__field">
                                    <span class="fa-label">Cue</span>
                                    <input class="fa-row__control" type="text" disabled="@Disabled" value="@row.Cue" @oninput="e => SetCue(sessionId, index, e)" />
                                </label>
                                @if (State.IsMainTrackSelected)
                                {
                                    <label class="fa-row__check">
                                        <input type="checkbox" disabled="@(Disabled || !exercise.InLibrary)" checked="@exercise.IsBenchmark" @onchange="e => SetBenchmark(row.ExerciseId, exercise.LibraryBenchmark, e)" />
                                        <span>Benchmark exercise</span>
                                    </label>
                                }
                                <a class="fa-row__guide" href="@($"exercises/{row.ExerciseId}/guide")" aria-label="@($"Guide for {name}")">Guide</a>
                                <div class="fa-row__actions">
                                    <Button Variant="ButtonVariant.Secondary" Disabled="@(Disabled || index == 0)" AccessibleName="@($"Move {name} up")" OnClick="() => Move(sessionId, index, up: true)">Move up</Button>
                                    <Button Variant="ButtonVariant.Secondary" Disabled="@(Disabled || index == session.Exercises.Count - 1)" AccessibleName="@($"Move {name} down")" OnClick="() => Move(sessionId, index, up: false)">Move down</Button>
                                    <Button Variant="ButtonVariant.Secondary" Disabled="Disabled" AccessibleName="@($"Remove {name}")" OnClick="() => Remove(sessionId, row.ExerciseId, index)">Remove</Button>
                                </div>
                            </div>
                        }

                        @if (problem is not null)
                        {
                            <p class="fa-well fa-session__problem" role="alert">@name: @problem</p>
                        }
                    </li>
                }
            </ul>

            <Button Variant="ButtonVariant.Secondary" Disabled="Disabled" AccessibleName="@($"Add Exercise to {session.Name}")" OnClick="() => _pickerSessionId = sessionId">Add Exercise from library</Button>
        </section>
    }

    <Button Variant="ButtonVariant.Secondary" Disabled="Disabled" OnClick="OpenAddSessionSheet">Add Session</Button>
</div>

<ExercisePicker Open="@(_pickerSessionId is not null)" Title="Add Exercise" Request="PickerRequestForOpenSession" OnPick="AddFromPickerAsync" OnClose="ClosePicker" />

<FormSheet Open="_sheetOpen" Title="@(_sheet.EditingSessionId is null ? "Add Session" : "Edit Session")" Saving="Saving" CanWrite="Page.CanWrite" ReadOnlyMessage="@Page.ReadOnlyMessage"
           Message="@_sheet.Message" OnClose="CloseSessionSheet">
    <ChildContent>
        <label class="fa-row__field">
            <span class="fa-label">Name</span>
            <input class="fa-row__control" type="text" @bind="_sheet.Name" @bind:event="oninput" />
        </label>
        @if (IsDailySheet)
        {
            <div class="fa-row__field">
                <span class="fa-label">Default day</span>
                <p class="fa-muted">Every day</p>
            </div>
        }
        else
        {
            <label class="fa-row__field">
                <span class="fa-label">Default day</span>
                <select class="fa-row__control" @bind="_sheet.Day">
                    @foreach (var day in Days)
                    {
                        <option value="@day">@day</option>
                    }
                </select>
            </label>
        }
        <label class="fa-row__field">
            <span class="fa-label">Type</span>
            <select class="fa-row__control" @bind="_sheet.Type">
                @foreach (var type in Enum.GetValues<SessionType>())
                {
                    <option value="@type">@type</option>
                }
            </select>
        </label>
        @if (State.IsMainTrackSelected && _sheet.Type == SessionType.Test)
        {
            <label class="fa-row__field">
                <span class="fa-label">Benchmark interval (weeks)</span>
                <input class="fa-row__control" type="text" inputmode="numeric" @bind="_sheet.BenchmarkIntervalWeeks" @bind:event="oninput" />
            </label>
        }
    </ChildContent>
    <Actions>
        <Button Variant="ButtonVariant.Primary" Disabled="context.WriteDisabled" OnClick="ApplySessionSheet">@(_sheet.EditingSessionId is null ? "Add Session" : "Done")</Button>
    </Actions>
</FormSheet>


