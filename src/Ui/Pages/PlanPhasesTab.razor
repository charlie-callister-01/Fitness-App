@using Core.Rules.Formatting
@using Core.Rules.Insight
@using System.Globalization
@* The Plan editor's Phases tab (design S-05, C-20): a row per Phase on the selected Track with the weeks and dates it covers; Edit expands
   the row in place to change the focus, the first and last week, the optional Phase goals and any Session overrides. Overlaps and reversed
   ranges are named in a message under the list and hold Save back. *@
<div class="fa-phases" @key="State.SelectedTrackId">
    @if (SelectedPhases.Count == 0)
    {
        <p class="fa-muted">No Phases for this Track. No Phases yet — add one to split the Track into blocks of weeks.</p>
    }

    <ul class="fa-phases__list">
        @foreach (var phase in SelectedPhases)
        {
            var id = phase.Id;
            var open = _expandedId == id;
            <li class="fa-phase fa-panel">
                <div class="fa-phase__summary">
                    <div>
                        <p class="fa-title fa-title--m fa-phase__name">@NameOf(phase)</p>
                        <p class="fa-muted fa-phase__weeks">@WeeksText(phase)</p>
                    </div>
                    <Button Variant="ButtonVariant.Secondary" AccessibleName="@(open ? $"Close {NameOf(phase)}" : $"Edit {NameOf(phase)}")" OnClick="() => Toggle(id)">@(open ? "Done" : "Edit")</Button>
                </div>

                @if (open)
                {
                    <div class="fa-phase__edit">
                        <label class="fa-phase__field">
                            <span class="fa-label">Focus</span>
                            <input class="fa-phase__control" type="text" disabled="@Disabled" value="@phase.Focus" @oninput="e => SetFocus(id, e)" />
                        </label>
                        <div class="fa-phase__pair">
                            <label class="fa-phase__field">
                                <span class="fa-label">First week</span>
                                <input class="fa-phase__control" type="number" inputmode="numeric" min="1" disabled="@Disabled" value="@phase.StartWeek" @onchange="e => SetWeek(id, e, first: true)" />
                            </label>
                            <label class="fa-phase__field">
                                <span class="fa-label">Last week</span>
                                <input class="fa-phase__control" type="number" inputmode="numeric" min="1" disabled="@Disabled" value="@phase.EndWeek" @onchange="e => SetWeek(id, e, first: false)" />
                            </label>
                        </div>

                        <p class="fa-label">Phase goals (optional)</p>
                        @if (phase.Goals.Count == 0)
                        {
                            <p class="fa-muted">No goal. With one, the Plan can tell you when you are ready to move on early.</p>
                        }

                        @for (var i = 0; i < phase.Goals.Count; i++)
                        {
                            var index = i;
                            var goal = phase.Goals[i];
                            <div class="fa-phase__goal">
                                <label class="fa-phase__field">
                                    <span class="fa-label">Goal Exercise</span>
                                    <select class="fa-phase__control" disabled="@Disabled" @onchange="e => SetGoalExercise(id, index, e)">
                                        @foreach (var exercise in Data.Snapshot.Exercises)
                                        {
                                            <option value="@exercise.Id" selected="@(exercise.Id == goal.ExerciseId)">@exercise.Name</option>
                                        }
                                    </select>
                                </label>
                                <div class="fa-phase__pair">
                                    <label class="fa-phase__field">
                                        <span class="fa-label">Weight (kg)</span>
                                        <input class="fa-phase__control" type="text" inputmode="decimal" disabled="@Disabled" value="@DisplayFormat.Trimmed(goal.WeightKg)" @onchange="e => SetGoalWeight(id, index, e)" />
                                    </label>
                                    <label class="fa-phase__field">
                                        <span class="fa-label">Reps</span>
                                        <input class="fa-phase__control" type="text" inputmode="numeric" disabled="@Disabled" value="@goal.Reps" @onchange="e => SetGoalReps(id, index, e)" />
                                    </label>
                                </div>
                                <Button Variant="ButtonVariant.Secondary" Disabled="Disabled" AccessibleName="@($"Remove goal {index + 1}")" OnClick="() => RemoveGoal(id, index)">Remove goal</Button>
                            </div>
                        }

                        @if (phase.SessionOverrides.Count > 0)
                        {
                            <p class="fa-label">Session overrides</p>
                            @for (var i = 0; i < phase.SessionOverrides.Count; i++)
                            {
                                var index = i;
                                var item = phase.SessionOverrides[i];
                                <div class="fa-phase__goal">
                                    <label class="fa-phase__field">
                                        <span class="fa-label">Override Session</span>
                                        <select class="fa-phase__control" disabled="@Disabled" @onchange="e => SetOverrideSession(id, index, e)">
                                            @foreach (var session in TrackSessions)
                                            {
                                                <option value="@session.Id" selected="@(session.Id == item.SessionId)">@session.Name</option>
                                            }
                                        </select>
                                    </label>
                                    <Button Variant="ButtonVariant.Secondary" Disabled="Disabled" AccessibleName="@($"Remove override {index + 1}")" OnClick="() => RemoveOverride(id, index)">Remove override</Button>
                                </div>
                            }
                        }

                        <div class="fa-phase__actions">
                            <Button Variant="ButtonVariant.Secondary" Disabled="@(Disabled || Data.Snapshot.Exercises.Count == 0)" OnClick="() => AddGoal(id)">Add goal</Button>
                            @if (TrackSessions.Count > 0)
                            {
                                <Button Variant="ButtonVariant.Secondary" Disabled="Disabled" OnClick="() => AddOverride(id)">Add override</Button>
                            }
                            <Button Variant="ButtonVariant.Secondary" Disabled="Disabled" AccessibleName="@($"Remove Phase {NameOf(phase)}")" OnClick="() => RemovePhase(id)">Remove Phase</Button>
                        </div>
                    </div>
                }
            </li>
        }
    </ul>

    @if (State.Snapshot.PhasesProblem is { } problem)
    {
        <p class="fa-well fa-phases__problem" role="alert">@problem</p>
    }

    <Button Variant="ButtonVariant.Secondary" Disabled="Disabled" OnClick="AddPhase">Add Phase</Button>
</div>
