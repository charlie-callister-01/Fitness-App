@page "/"
@using Core.Rules.Home
@* Home (S-01): the Today card, the week at a glance, Nudges, Recent PRs and Weight. Everything shown comes from HomeViewBuilder; this page
   renders it and starts things. *@
<div class="fa-root fa-home">
    <header class="fa-home__header">
        <div>
            <p class="fa-muted fa-home__date">@DateText</p>
            <h1 class="fa-title fa-title--l">@_view.Header.Greeting</h1>
        </div>
        <Button Variant="ButtonVariant.Secondary" OnClick="OnLogWeight">Log weight</Button>
    </header>

    <div class="fa-home__columns">
        <div class="fa-home__main">
            <TodayCard Card="_view.Today" Today="Page.Today" CanWrite="Page.CanWrite" ReadOnlyMessage="@Page.ReadOnlyMessage" Starting="_save.IsBusy"
                       OnStart="StartAsync" OnContinue="OnContinue" OnOpenSummary="OnOpenSummary"
                       ReviewReady="ReviewReady" OnOpenReview="OnOpenReview" />

            @if (_view.ShowAlternatives)
            {
                <div class="fa-home__alts">
                    <Button Variant="ButtonVariant.Secondary" Disabled="!Page.CanWrite" OnClick="OnDifferentSessionAsync">Do a different Session</Button>
                    <Button Variant="ButtonVariant.Secondary" OnClick="OnBuildCustom">Build a Custom workout</Button>
                </div>
                @if (_view.ShowLogPastWorkout)
                {
                    <button type="button" class="fa-home__link" disabled="@(!Page.CanWrite)" @onclick="OnLogPastWorkout">Log a past Workout</button>
                }
                @if (!Page.CanWrite && Page.ReadOnlyMessage is { } reason)
                {
                    <p class="fa-muted">@reason</p>
                }
            }

            @foreach (var daily in _view.DailyTracks)
            {
                <section class="fa-panel fa-home__daily" aria-label="@daily.TrackName" data-track="@daily.TrackId">
                    <div class="fa-home__daily-top">
                        <span class="fa-label">@daily.TrackName</span>
                        <span class="fa-muted">@DailyStreakText(daily.Streak)</span>
                    </div>
                    <h2 class="fa-title fa-title--m">@(daily.Session?.Name ?? daily.TrackName)</h2>
                    @if (daily.OnBreak)
                    {
                        <p class="fa-muted">On a Break</p>
                    }
                    else
                    {
                        @switch (daily.State)
                        {
                            case DailyTrackState.Done:
                                <div class="fa-home__daily-done">
                                    <StateChip Kind="StateChipKind.Done" />
                                    <span class="fa-muted">@daily.DonePercent% done</span>
                                </div>
                                break;
                            case DailyTrackState.InProgress when daily.InProgressWorkout is { } openWorkout:
                                <p class="fa-muted">In progress · @daily.DonePercent% done</p>
                                <Button Variant="ButtonVariant.Primary" AccessibleName="@($"Continue {daily.Session?.Name ?? daily.TrackName}")" OnClick="() => OnContinue(openWorkout)">Continue</Button>
                                break;
                            default:
                                <p class="fa-muted">Not started</p>
                                @if (daily.Session is { } dailySession)
                                {
                                    <Button Variant="ButtonVariant.Secondary" Disabled="!Page.CanWrite || _save.IsBusy" AccessibleName="@($"Start {dailySession.Name}")" OnClick="() => StartAsync(dailySession)">Start</Button>
                                }
                                break;
                        }
                    }
                </section>
            }

            @if (_view.Strip.Count > 0)
            {
                <WeekStrip Tiles="_view.Strip" OnOpenDay="OnOpenDay" />
            }

            @if (_view.Line is { } line)
            {
                <WeekLine Line="line" />
            }

            @foreach (var extra in _view.ExtraWeekLines)
            {
                <section class="fa-panel fa-home__extraline" aria-label="@extra.TrackName" data-track="@extra.TrackId">
                    <p class="fa-muted fa-home__extraline-summary">@ExtraLineSummary(extra)</p>
                    @if (extra.Sessions.Count > 0)
                    {
                        <div class="fa-home__extraline-sessions" role="group" aria-label="@($"{extra.TrackName} Sessions this week")">
                            @foreach (var item in extra.Sessions)
                            {
                                var session = item.Session;
                                <button type="button" class="fa-home__extrasession @(item.IsToday ? "fa-home__extrasession--today" : "")"
                                        disabled="@(!Page.CanWrite || _save.IsBusy)"
                                        aria-label="@ExtraSessionLabel(extra.TrackName, item)"
                                        @onclick="() => StartAsync(session)">
                                    <span class="fa-home__extrasession-name">@session.Name</span>
                                    <span class="fa-muted">@item.Date.ToString("ddd", System.Globalization.CultureInfo.InvariantCulture) · @ExtraStateWords(item.State)</span>
                                </button>
                            }
                        </div>
                    }
                </section>
            }
        </div>

        <div class="fa-home__side">
            @if (_view.Orbs is { } orbs)
            {
                <OrbRow Orbs="orbs" OnOpenProgress="OnOpenProgress" OnOpenCalendar="OnOpenCalendar" />
            }

            @if (_view.ShowNudges)
            {
                @foreach (var nudge in _view.Nudges)
                {
                    <NudgeCard Item="nudge" OnAction="OnNudgeAction" OnDismiss="OnNudgeDismiss" />
                }
            }

            <RecentPrsPanel Prs="_view.RecentPrs" Exercises="Data.Snapshot.Exercises" Converter="Converter" />
            <WeightPanel Panel="_view.Weight" Converter="Converter" OnLogWeight="OnLogWeight" />
        </div>
    </div>

    <DifferentSessionSheet Open="_differentOpen" Sessions="UndoneSessions" Saving="_save.IsBusy" CanWrite="Page.CanWrite" ReadOnlyMessage="@Page.ReadOnlyMessage"
                           OnPick="PickDifferentAsync" OnBuildCustom="BuildCustomFromSheet" OnClose="CloseDifferent" />
    <LogPastWorkoutSheet Open="_pastOpen" Today="Page.Today" Sessions="PlanSessions" Saving="_save.IsBusy" CanWrite="Page.CanWrite" ReadOnlyMessage="@Page.ReadOnlyMessage"
                         Message="@_pastMessage" OnStart="StartPastAsync" OnClose="ClosePast" />
    <LogWeightSheet Open="_weightOpen" InitialText="@LatestWeightText" LastText="@LastWeightText" UnitLabel="@Converter.WeightLabel"
                    Saving="_save.IsBusy" CanWrite="Page.CanWrite" ReadOnlyMessage="@Page.ReadOnlyMessage" Message="@_weightMessage"
                    OnSave="SaveWeightAsync" OnClose="CloseWeight" />
</div>
