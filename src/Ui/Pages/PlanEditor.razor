@page "/plans/{PlanId}"
@using Core.Model
@using Core.Rules.PlanEditing
@layout PushedPageLayout
@* The Plan editor (design S-05, C-20): Track selector, Settings, Phases and Sessions tabs over one draft (PlanEditState) that is saved
   together. Each tab is its own component and edits the shared state; this page owns the Track selector, tab choice, Save and leaving
   with unsaved changes. *@
<div class="fa-root fa-planeditor">
    @if (_state is null)
    {
        <h1 class="fa-title fa-title--l">Plan</h1>
        <p class="fa-muted">That Plan isn't here any more.</p>
        <Button Variant="ButtonVariant.Primary" Href="plans">Back to Plans</Button>
    }
    else
    {
        <h1 class="fa-title fa-title--l">@_state.Saved.Name</h1>
        @if (_state.Saved.IsActive)
        {
            <p class="fa-label fa-planeditor__active">@PlanProgress.ActiveLabel(_state.Saved, Page.Today)</p>
        }

        <p class="fa-planeditor__banner fa-well">Edits apply going forward. Past Workouts are unchanged.</p>

        <ReadOnlyWell CanWrite="Page.CanWrite" Message="@Page.ReadOnlyMessage" />

        <div class="fa-planeditor__tracks" role="group" aria-label="Tracks">
            <div class="fa-planeditor__track-chips">
                @for (var i = 0; i < _state.Draft.Tracks.Count; i++)
                {
                    var index = i;
                    var track = _state.Draft.Tracks[i];
                    <div class="fa-planeditor__track">
                        <Button Variant="ButtonVariant.Secondary" Pressed="_state.SelectedTrack.Id == track.Id" OnClick="() => SelectTrack(track.Id)">@track.Name</Button>
                        @if (index == 0)
                        {
                            <span class="fa-label fa-planeditor__track-hint">Main</span>
                        }
                    </div>
                }
                <Button Variant="ButtonVariant.Secondary" Disabled="Disabled" OnClick="OpenAddTrackSheet">+ Add Track</Button>
            </div>

            @if (_state.Draft.Tracks.Count > 1)
            {
                <div class="fa-planeditor__track-order">
                    <Button Variant="ButtonVariant.Secondary" Disabled="@(Disabled || _state.SelectedTrackIndex == 0)" AccessibleName="@($"Move {_state.SelectedTrack.Name} up")" OnClick="MoveTrackUp">Move up</Button>
                    <Button Variant="ButtonVariant.Secondary" Disabled="@(Disabled || _state.SelectedTrackIndex == _state.Draft.Tracks.Count - 1)" AccessibleName="@($"Move {_state.SelectedTrack.Name} down")" OnClick="MoveTrackDown">Move down</Button>
                </div>
            }

            @if (_trackMessage is { Length: > 0 })
            {
                <p class="fa-well fa-planeditor__track-problem" role="alert">@_trackMessage</p>
            }
        </div>

        <div class="fa-planeditor__tabs" role="group" aria-label="Plan sections">
            @foreach (var tab in Tabs)
            {
                var current = tab;
                <Button Variant="ButtonVariant.Secondary" Pressed="_tab == current" OnClick="() => ShowTab(current)">@current</Button>
            }
        </div>

        @switch (_tab)
        {
            case "Settings":
                <PlanSettingsTab State="_state" Disabled="Disabled" OnEdited="OnEdited" />
                break;
            case "Phases":
                <PlanPhasesTab State="_state" Disabled="Disabled" OnEdited="OnEdited" />
                break;
            default:
                <PlanSessionsTab State="_state" Page="Page" Saving="_save.IsBusy" OnEdited="OnEdited" />
                break;
        }

        <div class="fa-planeditor__save">
            @if (_state.Snapshot.ProblemTab is { } problemTab)
            {
                <p class="fa-muted" role="status">Fix the problem on the @problemTab tab to save.</p>
            }
            else if (_justSaved)
            {
                <p class="fa-muted" role="status">Saved.</p>
            }

            <Button Variant="ButtonVariant.Primary" Disabled="@(Disabled || !_state.IsDirty || _state.Snapshot.Composed is null)" OnClick="SaveAsync">Save</Button>
        </div>

        <FormSheet Open="_addTrackOpen" Title="Add Track" Saving="_save.IsBusy" CanWrite="Page.CanWrite" ReadOnlyMessage="@Page.ReadOnlyMessage"
                   Message="@_addTrackMessage" OnClose="CloseAddTrackSheet">
            <ChildContent>
                <label class="fa-planeditor__field">
                    <span class="fa-label">Name</span>
                    <input class="fa-planeditor__control" type="text" @bind="_newTrackName" @bind:event="oninput" />
                </label>
                <label class="fa-planeditor__field">
                    <span class="fa-label">Cadence</span>
                    <select class="fa-planeditor__control" @bind="_newTrackCadence">
                        @foreach (var cadence in Enum.GetValues<TrackCadence>())
                        {
                            <option value="@cadence">@cadence</option>
                        }
                    </select>
                </label>
            </ChildContent>
            <Actions>
                <Button Variant="ButtonVariant.Primary" Disabled="context.WriteDisabled" OnClick="ApplyAddTrack">Add Track</Button>
            </Actions>
        </FormSheet>

        <FormSheet Open="@(_leaveTarget is not null)" Title="Discard changes?" CancelLabel="" OnClose="KeepEditing">
            <ChildContent>
                <p>You have changes that are not saved.</p>
            </ChildContent>
            <Actions>
                <Button Variant="ButtonVariant.Primary" OnClick="KeepEditing">Keep editing</Button>
                <Button Variant="ButtonVariant.Secondary" OnClick="Discard">Discard</Button>
            </Actions>
        </FormSheet>
    }
</div>
